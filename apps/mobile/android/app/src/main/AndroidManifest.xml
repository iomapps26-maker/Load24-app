<manifest xmlns:android="http://schemas.android.com/apk/res/android" xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <!-- For saving downloaded QR codes to the gallery (see WalletScreen/HomeScreen's
         downloadQr) via @react-native-camera-roll/camera-roll. On API 29+, CameraRoll.save()
         writes through MediaStore's scoped-storage insert() and needs no permission at all;
         WRITE_EXTERNAL_STORAGE is only exercised by the pre-Q direct-file-write fallback,
         so it's the only permission actually required here. Do not add READ_MEDIA_IMAGES /
         READ_EXTERNAL_STORAGE back — this app never reads the user's existing photos, and
         Google Play's photo/video permissions policy flags those as unjustified for a
         write-only flow like this one. -->
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="28" />

    <!-- Runtime-requested by pushNotifications.js on API 33+ (Android 13
         made showing a notification permission-gated, same as camera/
         location) — without it, FCM messages still arrive but never render
         in the system tray. No-op on API < 33 (permission is granted at
         install time there, this line just does nothing). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
      android:name=".MainApplication"
      android:label="@string/app_name"
      android:icon="@mipmap/ic_launcher"
      android:roundIcon="@mipmap/ic_launcher_round"
      android:allowBackup="false"
      android:theme="@style/AppTheme">
      <!-- @react-native-firebase/messaging needs a channel to post a
           background/killed-state notification into on API 26+ — pointed at
           pushNotifications.js's createNotificationChannel('default', ...)
           call, which must run (it does, at JS module load) before any push
           arrives, or Android silently falls back to its own default
           channel with no custom sound/importance. Icon reuses the launcher
           icon for now — Android renders notification icons as a flat white
           silhouette regardless, so a dedicated monochrome asset is a
           cosmetic follow-up, not a functional gap. -->
      <!-- tools:replace is required here: @react-native-firebase/messaging's
           own AndroidManifest.xml already declares both of these same keys
           (with an empty placeholder value), and the manifest merger treats
           a plain re-declaration as a conflict rather than an override. -->
      <meta-data android:name="com.google.firebase.messaging.default_notification_channel_id" android:value="default" tools:replace="android:value" />
      <meta-data android:name="com.google.firebase.messaging.default_notification_icon" android:resource="@mipmap/ic_launcher" tools:replace="android:resource" />
      <activity
        android:name=".MainActivity"
        android:label="@string/app_name"
        android:configChanges="keyboard|keyboardHidden|orientation|screenLayout|screenSize|smallestScreenSize|uiMode"
        android:launchMode="singleTask"
        android:windowSoftInputMode="adjustResize"
        android:exported="true">
        <intent-filter>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent-filter>
        <!-- Catches the redirect back from Google OAuth (supabase.auth.signInWithOAuth) -->
        <intent-filter android:autoVerify="false">
            <action android:name="android.intent.action.VIEW" />
            <category android:name="android.intent.category.DEFAULT" />
            <category android:name="android.intent.category.BROWSABLE" />
            <data android:scheme="load24" android:host="auth-callback" />
        </intent-filter>
        <!-- Android App Link for WhatsApp's "View Load"/"Bid" buttons
             (https://load24.in/loads/:id — see App.jsx's Linking handling
             and PlaceBidScreen.jsx's loadId param). autoVerify="true" only
             actually opens the app directly (instead of falling back to a
             disambiguation dialog or the browser) once load24.in serves
             https://load24.in/.well-known/assetlinks.json listing this
             app's applicationId + signing certificate SHA-256 fingerprint. -->
        <intent-filter android:autoVerify="true">
            <action android:name="android.intent.action.VIEW" />
            <category android:name="android.intent.category.DEFAULT" />
            <category android:name="android.intent.category.BROWSABLE" />
            <data android:scheme="https" android:host="load24.in" android:pathPrefix="/loads" />
        </intent-filter>
        <!-- Custom-scheme fallback for the same links (load24://loads/:id)
             — not something WhatsApp's URL button can open directly (Meta
             requires the button's own URL to be http/https), but kept for
             any other trigger of the same link before App Links
             verification has propagated, same scheme as the OAuth callback
             above, just a different host/path. -->
        <intent-filter>
            <action android:name="android.intent.action.VIEW" />
            <category android:name="android.intent.category.DEFAULT" />
            <category android:name="android.intent.category.BROWSABLE" />
            <data android:scheme="load24" android:host="loads" />
        </intent-filter>
      </activity>
    </application>
</manifest>
