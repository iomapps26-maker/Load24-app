PORT=4000
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-a-real-service-role-key
SUPABASE_ANON_KEY=replace-with-a-real-anon-key

# WhatsApp Business Cloud API (used by src/lib/whatsapp.js for OTP login)
WHATSAPP_ACCESS_TOKEN=replace-with-a-real-access-token
WHATSAPP_PHONE_NUMBER_ID=replace-with-a-real-phone-number-id
WHATSAPP_BUSINESS_ACCOUNT_ID=replace-with-a-real-waba-id
WHATSAPP_OTP_TEMPLATE_NAME=load24_whatsapp_otp
WHATSAPP_OTP_TEMPLATE_LANG=hi

# Razorpay (used by src/lib/razorpay.js for Wallet Add Money + webhook verification)
RAZORPAY_KEY_ID=replace-with-a-real-key-id
RAZORPAY_KEY_SECRET=replace-with-a-real-key-secret
RAZORPAY_WEBHOOK_SECRET=replace-with-a-real-webhook-secret

# Google Maps Platform (used by src/lib/googleMaps.js to fill loads.distance_km
# with driving distance at posting time). Needs the Distance Matrix API
# enabled and billing set up on the Google Cloud project — server-side key
# only, never sent to the mobile app.
GOOGLE_MAPS_API_KEY=replace-with-a-real-key
