PORT=4000
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-a-real-service-role-key
SUPABASE_ANON_KEY=replace-with-a-real-anon-key

# WhatsApp Business Cloud API (used by src/lib/whatsapp.js for OTP login)
WHATSAPP_ACCESS_TOKEN=replace-with-a-real-access-token
WHATSAPP_PHONE_NUMBER_ID=replace-with-a-real-phone-number-id
WHATSAPP_BUSINESS_ACCOUNT_ID=replace-with-a-real-waba-id
WHATSAPP_OTP_TEMPLATE_NAME=load24_whatsapp_otp
WHATSAPP_OTP_TEMPLATE_LANG=hi

# Sent by src/lib/whatsapp.js's sendWhatsAppLoadAlert when a load is found
# near a truck owner's posted-available truck (see truckAvailability.js's
# notifyNearbyLoads). Needs its own Meta-approved template — must be
# submitted and approved in Meta Business Manager before this can send;
# expects two named body variables: {{material_type}}, {{city}} (Meta's
# newer named-variable format, not the older positional {{1}}/{{2}}).
WHATSAPP_LOAD_ALERT_TEMPLATE_NAME=load24_load_nearby_alert
WHATSAPP_LOAD_ALERT_TEMPLATE_LANG=hi

# Sent by src/lib/whatsapp.js's sendWhatsAppLoadBroadcast when a new load is
# posted near a matching, verified truck owner (see loads.js's
# notifyNearbyTruckOwners). Needs its own Meta-approved UTILITY template —
# see scripts/create-whatsapp-load-broadcast-template.mjs to submit it —
# with five POSITIONAL body variables in order ({{1}}=route, {{2}}=vehicle_type,
# {{3}}=tonnage, {{4}}=pickup, {{5}}=freight; WhatsApp Manager's editor
# rejects the named-variable format for this account) and two Visit-Website
# URL buttons, "View Load" and "Bid", both https://load24.in/loads/{{1}}
# (the load id filled in per-message) — both open PlaceBidScreen in the app
# via an Android App Link, no webhook involved. Requires load24.in to serve
# https://load24.in/.well-known/assetlinks.json (see AndroidManifest.xml's
# App Links intent-filter) or Android just opens a browser instead of the app.
WHATSAPP_LOAD_BROADCAST_TEMPLATE_NAME=load24_load_broadcast
WHATSAPP_LOAD_BROADCAST_TEMPLATE_LANG=hi

# Razorpay (used by src/lib/razorpay.js for Wallet Add Money + webhook verification)
RAZORPAY_KEY_ID=replace-with-a-real-key-id
RAZORPAY_KEY_SECRET=replace-with-a-real-key-secret
RAZORPAY_WEBHOOK_SECRET=replace-with-a-real-webhook-secret

# Google Maps Platform (used by src/lib/googleMaps.js to fill loads.distance_km
# with driving distance at posting time). Needs the Distance Matrix API
# enabled and billing set up on the Google Cloud project — server-side key
# only, never sent to the mobile app.
GOOGLE_MAPS_API_KEY=replace-with-a-real-key
